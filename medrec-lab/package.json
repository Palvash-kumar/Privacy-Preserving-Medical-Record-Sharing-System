{
  "name": "medrec-lab",
  "version": "1.0.0",
  "description": "MedRec baseline implementation — Privacy-Preserving Medical Record Sharing System",
  "main": "index.js",
  "scripts": {
    "compile": "HOME=\"$(pwd)/.home\" npx hardhat compile",
    "test": "HOME=\"$(pwd)/.home\" npx hardhat test",
    "node": "HOME=\"$(pwd)/.home\" npx hardhat node",
    "deploy": "HOME=\"$(pwd)/.home\" npx hardhat run client/deploy.js",
    "deploy:plus": "HOME=\"$(pwd)/.home\" npx hardhat run client/deploy-plus.js",
    "gatekeeper": "node gatekeeper/index.js",
    "bench:gas": "HOME=\"$(pwd)/.home\" npx hardhat run bench/gas-bench.js",
    "bench:latency": "HOME=\"$(pwd)/.home\" npx hardhat run bench/latency-bench.js",
    "bench:throughput": "HOME=\"$(pwd)/.home\" npx hardhat run bench/throughput-bench.js",
    "bench:security": "HOME=\"$(pwd)/.home\" npx hardhat run bench/security-experiments.js",
    "charts": "node bench/generate-charts.js",
    "demo:weakness": "HOME=\"$(pwd)/.home\" npx hardhat run analysis/weakness-demos.js",
    "demo:observer": "HOME=\"$(pwd)/.home\" npx hardhat run analysis/chain-observer.js",
    "demo:compare": "HOME=\"$(pwd)/.home\" npx hardhat run analysis/observer-compare.js"
  },
  "keywords": [
    "medrec",
    "blockchain",
    "privacy",
    "medical-records"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ethers": "^6.17.0",
    "express": "^5.3.0"
  }
}
